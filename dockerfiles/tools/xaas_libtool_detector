#!/usr/bin/env python3

import argparse
import json
import os.path
import shlex
import subprocess
from concurrent.futures.thread import ThreadPoolExecutor


def get_compiler_target_path(options: list[str], errmsg = None) -> str:
    assert "-o" in options, f"you must specify a target with '-o': {errmsg or options}"
    return options[options.index("-o") + 1]


_check_libtool_features_cache = {}

def check_libtool_features(libtool_path: str) -> tuple[str, bool, bool]:
    """
    :param libtool_path: the path to the libtool binary to query
    :return: shared libs enabled, static libs enabled
    """

    cache_key = os.path.abspath(libtool_path)
    if cache_key in _check_libtool_features_cache:
        return _check_libtool_features_cache[cache_key]

    proc = subprocess.run(
        [libtool_path, "--version"],
        check=True, capture_output=True, text=True, encoding="utf-8")
    version = proc.stdout.splitlines()[0]

    proc = subprocess.run(
        [libtool_path, "--features"],
        check=True, capture_output=True, text=True, encoding="utf-8")

    states = {}
    for line in proc.stdout.splitlines():
        if line.startswith("host:"):
            continue

        # should be one of '^(enable|disable) (shared|static) libraries$'
        libs_state, libs_type, libraries = line.split()
        assert libs_state in ["enable", "disable"], line
        assert libs_type in ["shared", "static"], line
        assert libraries == "libraries", line

        states[libs_type] = (libs_state == "enable")

    result = version, states["shared"], states["static"]
    _check_libtool_features_cache[libtool_path] = result
    return result


def get_libtool_compiler_commands(
        libtool_version: str, shared_enabled: bool, static_enabled: bool,
        work_dir: str,
        source_file: str,
        lo_target: str,
        libtool: str, libtool_options: list[str],
        compiler: str, compiler_options: list[str],
) -> tuple[list[dict], str]:
    # run libtool in dry-run mode to extract the actual compile commands
    libtool_compiler_commands = subprocess.run(
        [
            libtool,
            "--dry-run",
            *libtool_options,
            compiler,
            *compiler_options,
            # prevent libtool from adding shell redirects to the second command (if both shared and static libraries are enabled)
            "-no-suppress",
        ],
        cwd=work_dir,
        check=True, capture_output=True, text=True, encoding="utf-8",
    ).stdout.splitlines()

    libtool_compiler_arguments = []
    for sub_command in libtool_compiler_commands:
        sub_arguments = shlex.split(sub_command)
        assert len(sub_arguments) >= 3 and sub_arguments[:2] == ["libtool:", "compile:"], sub_arguments
        libtool_compiler_arguments.append(sub_arguments[2:])

    # figure out which of the compile commands correspond to which output files so that we can generate the .lo file later
    pic_object = "none"
    non_pic_object = "none"

    result_compiledb_entries = []

    i = 0
    if shared_enabled:
        pic_object = get_compiler_target_path(libtool_compiler_arguments[i])
        result_compiledb_entries.append({
            "file": source_file,
            "directory": work_dir,
            "command": shlex.join(libtool_compiler_arguments[i]),
        })
        i += 1

    if static_enabled:
        non_pic_object = get_compiler_target_path(libtool_compiler_arguments[i])
        result_compiledb_entries.append({
            "file": source_file,
            "directory": work_dir,
            "command": shlex.join(libtool_compiler_arguments[i]),
        })
        i += 1

    assert i == len(libtool_compiler_commands), f"not all the compile commands printed by libtool could be used: {libtool_compiler_commands}"

    result_lo_generation_line = f"printf '%s\\n' {shlex.quote('# Generated by ' + libtool_version)} pic_object={shlex.quote(pic_object)} non_pic_object={shlex.quote(non_pic_object)} > {shlex.quote(os.path.join(work_dir, lo_target))}"

    return result_compiledb_entries, result_lo_generation_line


arg_parser = argparse.ArgumentParser(description="Identify entries from a compile_commands.json which use libtool.")
arg_parser.add_argument("--input", help="path to input compile_commands.json")
arg_parser.add_argument("--output-normal", help="path to output compile_commands.json")
arg_parser.add_argument("--output-lo", help="path to output .lo file generation script")
args = arg_parser.parse_args()

with open(args.input) as f:
    data = json.load(f)

compiledb_entries_normal = []
lo_generation_lines = []

with ThreadPoolExecutor() as executor:
    futures = []
    for entry in data:
        source_file = entry["file"]
        work_dir = entry["directory"]

        command = entry.get("command")
        arguments = entry.get("arguments")

        assert bool(command) != bool(arguments), f"compile_commands.json entry must contain exactly one of either 'command' or 'arguments'! {entry}"
        if command:
            # split the raw command string
            arguments = shlex.split(command)
        else:
            command = shlex.join(arguments)

        assert len(arguments) > 1, f"compile_commands.json entry has no arguments! {entry}"

        # check if the command invokes libtool
        if not arguments[0].endswith("libtool"):
            compiledb_entries_normal.append(entry)
            continue

        # separate the libtool options from the other ones
        i = 1
        libtool = arguments[0]
        libtool_options = []
        while i < len(arguments) and arguments[i].startswith("--"):
            libtool_options.append(arguments[i])
            i += 1

        # ensure that libtool is being invoked in compile mode
        assert "--mode=compile" in libtool_options, f"not sure how to handle libtool invocation without --mode=compile: {command}"

        mode_arguments = arguments[i:]
        compiler = mode_arguments[0]
        compiler_options = mode_arguments[1:]

        # extract the .lo file name
        lo_target = get_compiler_target_path(compiler_options, command)

        # libtool can automatically convert some other extensions to .lo, but we won't bother implementing that...
        assert lo_target.endswith(".lo"), f"cannot determine name of library object from '{lo_target}'"

        libtool_version, shared_enabled, static_enabled = check_libtool_features(os.path.join(work_dir, libtool))

        futures.append(executor.submit(
            get_libtool_compiler_commands,
            libtool_version=libtool_version, shared_enabled=shared_enabled, static_enabled=static_enabled,
            work_dir=work_dir,
            source_file=source_file,
            lo_target=lo_target,
            libtool=libtool, libtool_options=libtool_options,
            compiler=compiler, compiler_options=compiler_options,
        ))

    for future in futures:
        compiledb_entries, lo_generation_line = future.result()

        compiledb_entries_normal.extend(compiledb_entries)
        lo_generation_lines.append(lo_generation_line)


with open(args.output_normal, "w") as f:
    json.dump(compiledb_entries_normal, f, indent="  ")

with open(args.output_lo, "w") as f:
    f.write("\n".join(lo_generation_lines))

